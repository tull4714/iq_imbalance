/RM/rmoveto ld
/C/curveto ld
/t/show ld
/L/lineto ld
/RL/rlineto ld
/ML/setmiterlimit ld
/CT/concat ld
/f/fill ld
/N/newpath ld
/S/stroke ld
/CC/setcmykcolor ld
/A/ashow ld
/cp/closepath ld
/RC/setrgbcolor ld
